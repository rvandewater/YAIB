# Settings for Support Vector Machine classifier.
# Note: kernel SVMs scale quadratically with the number of training samples.

# Common settings for ML models
include "configs/prediction_models/common/MLCommon.gin"

# Train params
train_common.model = @SVMClassifier

model/hyperparameter.class_to_tune = @SVMClassifier
model/hyperparameter.C = (1e-2, 1e2, "log")
model/hyperparameter.kernel = ["rbf", "linear"]
model/hyperparameter.gamma = ["scale", "auto"]
